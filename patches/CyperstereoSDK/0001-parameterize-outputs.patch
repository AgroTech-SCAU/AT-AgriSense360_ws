+
+    // Project patch: replace {index} in frame ids and topic names so outputs
+    // can be named independently of the vendor defaults "camN" / "/camN/...".
+    std::string FormatIndexedName(const std::string &tmpl, int index) const
+    {
+        std::string out = tmpl;
+        const std::string token = "{index}";
+        const std::string value = std::to_string(index);
+        std::string::size_type pos = 0;
+        while ((pos = out.find(token, pos)) != std::string::npos) {
+            out.replace(pos, token.size(), value);
+            pos += value.size();
+        }
+        return out;
+    }
 
